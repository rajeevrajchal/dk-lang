# Swap to a postgresql:// URL for a real deployment; SQLite is the
# zero-config default for local dev.
DATABASE_URL="file:./dev.db"

# openssl rand -base64 32
AUTH_SECRET="replace-me"

# Optional: enable real OCR/vision extraction for report-card uploads.
# Without these, lib/ocr.ts falls back to a manual-entry stub so the upload
# flow still works end to end in dev.
# OCR_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
