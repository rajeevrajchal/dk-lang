# ---------------------------------------------------------------------------
# Database — Supabase PostgreSQL
#
# Both come from your Supabase project: Settings -> Database -> Connection
# string. Two different URLs on purpose:
#
#   DATABASE_URL  the POOLED connection (PgBouncer, port 6543). What the
#                 application uses. Serverless functions open a lot of short
#                 connections and Postgres does not like that; the pooler is
#                 what makes it workable.
#   DIRECT_URL    the DIRECT connection (port 5432). What Prisma Migrate uses.
#                 Migrations need session-level state that a transaction pooler
#                 does not provide, so `migrate deploy` fails if this points at
#                 the pooler.
# ---------------------------------------------------------------------------
# NOTE: percent-encode the password. Characters like # & / ? @ + have meaning
# in a URL — a literal "#" in particular starts a fragment, so everything after
# it is silently discarded and the host is misparsed.
#   #  ->  %23      &  ->  %26      /  ->  %2F      @  ->  %40
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase — authentication and storage
#
# Settings -> API. The anon key is safe in the browser; the service-role key
# bypasses Row Level Security and must never be sent to the client or
# committed. Only lib/supabase/admin.ts reads it, and that module refuses to
# load outside the server.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Where Supabase should send the user back after an OAuth round trip. Must
# also be listed under Authentication -> URL Configuration -> Redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Auth
#
# Both Google and email/password go through Supabase Auth, so there is nothing
# to configure here. Google is set up in the dashboard (Authentication ->
# Providers -> Google); Supabase holds the client secret and the app never sees
# it. See docs/supabase-migration.md.
#
# There is no AUTH_SECRET any more — NextAuth has been removed. Two session
# systems could not coexist with Row Level Security: a NextAuth-authenticated
# user had no Supabase JWT, so every query was denied.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# AI providers
#
# Routed through the Vercel AI SDK (lib/ai/registry.ts), so the app is not tied
# to one vendor. Set whichever you have: with none, every generated feature
# degrades to its authored fallback and the app still works.
#
#   ANTHROPIC_API_KEY  Claude. The default for every task.
#   OPENAI_API_KEY     GPT. Used when AI_PROVIDER=openai, and as the fallback
#                      when the primary provider has no key.
#
# AI_PROVIDER picks the default provider; per-task overrides live in
# lib/ai/registry.ts.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_PROVIDER=anthropic

# Optional: real OCR/vision extraction for report-card uploads. Without it,
# lib/ocr.ts falls back to a manual-entry stub so the flow still works.
# OCR_PROVIDER=anthropic
