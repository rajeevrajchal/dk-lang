// Danish Modultest / PD3 Prep App — data model
//
// Runs on Supabase PostgreSQL. Prisma is the query layer and owns migrations;
// Supabase provides the database, authentication and file storage. See
// docs/supabase-migration.md for how the two fit together and why the app
// talks to Postgres through Prisma rather than through supabase-js.
//
// The "enum-shaped" fields below are still plain Strings validated at the app
// layer (lib/constants.ts), exactly as they were on SQLite. Promoting them to
// native Postgres enums is a real improvement and is deliberately NOT part of
// this migration: it would change write semantics — every insert would have to
// match the type exactly, and adding a value later needs its own migration —
// and this change set's job is to move infrastructure without altering
// behaviour. Tracked as follow-up in docs/supabase-migration.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (PgBouncer, port 6543) for the application: Supabase
  // pools transactions, which is what a serverless deployment needs.
  url = env("DATABASE_URL")
  // Direct connection (port 5432) for migrations. Prisma Migrate needs
  // session-level state a transaction pooler does not provide, so pointing
  // both at the pooler makes `migrate deploy` fail.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth Prisma adapter shape, kept even though this is single-learner
// today — costs nothing and means a second learner is a config change, not a
// migration).
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  createdAt     DateTime  @default(now())

  // Link to the Supabase Auth identity (auth.users.id, a UUID), set the first
  // time this person signs in with Google.
  //
  // A separate column rather than making it the primary key: `id` is a cuid
  // referenced by fifteen foreign keys and thousands of existing rows, and
  // rewriting it to a UUID would mean rewriting all of them. Mapping instead
  // means an existing learner keeps every attempt, note and lesson they have
  // ever recorded when they switch to signing in with Google.
  //
  // Null for accounts that only ever use email and password.
  supabaseUserId String? @unique
  // Where the account came from, for showing the right thing in Settings.
  authProvider   String  @default("credentials") // credentials | google

  accounts          Account[]
  sessions          Session[]
  attempts          Attempt[]
  constructStats    ConstructAccuracy[]
  srsStates         SrsState[]
  vocabSrsStates    VocabSrsState[]
  examSessions      ExamSession[]
  moduleSkillStatus ModuleSkillStatus[]
  reportCards       ReportCard[]
  exerciseAttempts  ExerciseAttempt[]
  lessonProgress    LessonProgress[]
  profile           UserProfile?
  officialResults   OfficialTestResult[]
  readingProgress   ReadingProgress[]
  savedWords        SavedWord[]
  readingNotes      ReadingNote[]
  readingHighlights ReadingHighlight[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Curriculum structure: modules, tiers, constructs, vocab
// ---------------------------------------------------------------------------

// Modul 1..5. Modul 5 is PD3 (isFinalExam = true) rather than a routine
// modultest — the exam engine branches on that flag.
model Module {
  id           Int     @id // 1..5
  slug         String  @unique // "modul-1" .. "modul-5"
  name         String
  cefrGoal     String // e.g. "A2 -> B1 transition"
  description  String
  isFinalExam  Boolean @default(false) // true only for Modul 5 / PD3
  isOralOnly   Boolean @default(false) // true only for Modul 1
  order        Int

  items             Item[]
  vocabItems        VocabItem[]
  examSessions      ExamSession[]
  moduleSkillStatus ModuleSkillStatus[]
}

// Complexity ladder, global across modules (module + tier is what an Item
// actually carries).
model Tier {
  id          Int    @id // 1..4
  name        String // "Tier 1" etc.
  description String

  items      Item[]
  constructs Construct[]
}

// A specific grammatical/lexical construct, e.g. "subordinate-clause:fordi".
// This is the unit the weak-area engine reports on — never just "module" or
// "skill" alone.
model Construct {
  id          String @id @default(cuid())
  code        String @unique // "subordinate-clause:fordi"
  name        String // "Subordinate clause with 'fordi'"
  description String
  tierId      Int

  tier            Tier                @relation(fields: [tierId], references: [id])
  itemConstructs  ItemConstruct[]
  constructAccura ConstructAccuracy[]
}

// A single practice question/task. Always `generated: true` — see
// docs/content-validation.md for how these are calibrated and never sourced
// from the real SIRI bank.
model Item {
  id          String   @id @default(cuid())
  moduleId    Int
  skill       String // READING | LISTENING | WRITING | SPEAKING
  tierId      Int
  type        String // MULTIPLE_CHOICE | TRUE_FALSE | GAP_FILL | MATCHING
  topic       String // ARBEJDE | UDDANNELSE | HVERDAGSLIV | MEDBORGERSKAB
  passageId   String? // stable key shared by items on the same passage (see lib/content-gen)
  passageText String? // reading passage / listening transcript, if any
  audioUrl    String? // pre-generated TTS audio for LISTENING items
  promptText  String
  optionsJson String? // JSON-encoded options (MC/matching)
  answerJson  String // JSON-encoded correct answer(s)
  explanation String? // shown after submission
  rubricJson  String? // for WRITING/SPEAKING: fixed per-tier rubric
  generated   Boolean  @default(true)
  createdAt   DateTime @default(now())

  module         Module          @relation(fields: [moduleId], references: [id])
  tier           Tier            @relation(fields: [tierId], references: [id])
  itemConstructs ItemConstruct[]
  attempts       Attempt[]

  @@index([moduleId, skill, tierId])
}

model ItemConstruct {
  itemId      String
  constructId String

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  construct Construct @relation(fields: [constructId], references: [id], onDelete: Cascade)

  @@id([itemId, constructId])
}

model VocabItem {
  id              String  @id @default(cuid())
  moduleId        Int
  topic           String // ARBEJDE | UDDANNELSE | HVERDAGSLIV | MEDBORGERSKAB
  danish          String
  translation     String
  exampleSentence String?

  module         Module          @relation(fields: [moduleId], references: [id])
  vocabSrsStates VocabSrsState[]
}

// ---------------------------------------------------------------------------
// Attempts + adaptive tracking
// ---------------------------------------------------------------------------

model Attempt {
  id            String   @id @default(cuid())
  userId        String
  itemId        String
  examSessionId String?
  responseJson  String // learner's raw response
  isCorrect     Boolean
  timeMs        Int?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  item        Item         @relation(fields: [itemId], references: [id])
  examSession ExamSession? @relation(fields: [examSessionId], references: [id])

  @@index([userId, itemId])
}

// Aggregated, continuously-updated accuracy per (user, construct, skill).
// This is what the "you drop to 40% on 'selvom'" recommendation reads from,
// so it's maintained as attempts land rather than recomputed from scratch.
model ConstructAccuracy {
  id            String    @id @default(cuid())
  userId        String
  constructId   String
  skill         String // READING | LISTENING | WRITING | SPEAKING
  correctCount  Int       @default(0)
  totalCount    Int       @default(0)
  lastAttemptAt DateTime?
  updatedAt     DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  construct Construct @relation(fields: [constructId], references: [id])

  @@unique([userId, constructId, skill])
}

// Spaced-repetition state, SM-2-style, for constructs (grammar) — resurfaces
// earlier now-easy constructs while the growing edge keeps moving forward.
model SrsState {
  id             String    @id @default(cuid())
  userId         String
  constructId    String
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  dueAt          DateTime  @default(now())
  lastReviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, constructId])
}

model VocabSrsState {
  id             String    @id @default(cuid())
  userId         String
  vocabId        String
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  dueAt          DateTime  @default(now())
  lastReviewedAt DateTime?

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocab VocabItem @relation(fields: [vocabId], references: [id])

  @@unique([userId, vocabId])
}

// ---------------------------------------------------------------------------
// Exam simulation (timed mock modultest / mock PD3)
// ---------------------------------------------------------------------------

model ExamSession {
  id          String    @id @default(cuid())
  userId      String
  moduleId    Int
  examType    String // MODULTEST | PD3
  status      String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | ABANDONED
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  scoresJson  String? // per-skill score breakdown once completed
  passedJson  String? // per-skill pass/fail once completed

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module   Module    @relation(fields: [moduleId], references: [id])
  attempts Attempt[]
  // Populated for the opgave-format mock test; the older item-based mock
  // populates `attempts` instead. A session uses one or the other.
  exerciseAttempts ExerciseAttempt[]
}

// ---------------------------------------------------------------------------
// Module unlock state — in-app mock pass vs verified official result are
// tracked as two distinct fields, never merged. See docs/unlock-logic.md.
// ---------------------------------------------------------------------------

model ModuleSkillStatus {
  id       String @id @default(cuid())
  userId   String
  moduleId Int
  skill    String // READING | LISTENING | WRITING | SPEAKING

  inAppPassed   Boolean   @default(false)
  inAppScore    Float?
  inAppPassedAt DateTime?

  officialPassed   Boolean? // null = no verified record yet
  officialSourceId String? // ReportCard.id that set this
  officialSetAt    DateTime?

  discrepancy     Boolean @default(false) // true if official conflicted with in-app at reconciliation time
  discrepancyNote String?

  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id])

  @@unique([userId, moduleId, skill])
}

// ---------------------------------------------------------------------------
// Class course progress.
//
// One row per learner per lesson. Separate from Attempt and ExerciseAttempt
// because the Class and the Practice Zone answer different questions: this
// records "have I been taught this and did I follow it", not "can I perform
// it under test conditions". Keyed by lesson slug rather than an id, so a
// lesson keeps its progress when the curriculum is re-ordered around it.
// ---------------------------------------------------------------------------

model LessonProgress {
  id         String @id @default(cuid())
  userId     String
  lessonSlug String
  // Chapter it was taken in, for reporting. Nullable: a lesson can be opened
  // directly from the older /theory route, outside any chapter.
  chapterId  String?

  // Correct out of the auto-checkable exercises. Null when a lesson has none.
  score Int?
  total Int?
  // Raw answers, so a learner can see what they wrote last time.
  responsesJson String?

  // Lifecycle, so a lesson can be left and resumed. Defaults to COMPLETED so
  // every row written before this field existed keeps meaning exactly what it
  // meant: a finished lesson. A row is created as IN_PROGRESS the first time
  // the lesson is opened, and promoted on submission.
  status        String    @default("COMPLETED") // IN_PROGRESS | COMPLETED
  startedAt     DateTime?
  lastVisitedAt DateTime?

  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonSlug])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Modultest-style exercises ("opgaver").
//
// Separate from Attempt on purpose. Attempt records ONE Item answer and feeds
// the construct/SRS engine. ExerciseAttempt records a whole opgave — a
// Læsning Opgave 1 with six sub-answers is one row here — and exists to drive
// exercise history: which variants the learner has already sat, so the
// selector never serves the same content twice while still repeating formats.
// See lib/exercises/registry.ts.
// ---------------------------------------------------------------------------

model ExerciseAttempt {
  id        String @id @default(cuid())
  userId    String
  moduleId  Int
  category  String // READING | WRITING | SPEAKING | LISTENING
  taskType  String // e.g. "reading_task_1_matching"
  variantId String // e.g. "r1-bolig" — stable across reseeds
  topic     String

  status String @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | ABANDONED

  // Set when this opgave is one part of a timed mock modultest rather than a
  // standalone practice exercise. orderIndex is its position in that test
  // (Opgave 1..4 then the writing task), and feedback is withheld until the
  // whole session is submitted — see app/api/mock-test.
  examSessionId String?
  orderIndex    Int?

  // Set only for LLM-generated exercises: the whole variant, answer key
  // included. It lives here because generation is per-attempt — the key has to
  // survive from /next until the learner submits, and it must never be sent to
  // the browser. Authored exercises leave this null and are looked up by
  // variantId in the registry instead.
  generated     Boolean @default(false)
  variantJson   String?

  // Cached word-by-word / sentence-by-sentence breakdown of this opgave's
  // Danish text, generated on demand after the learner has answered. Cached
  // because it is expensive and the text never changes once served.
  explanationJson String?

  // Conversation state for a speaking opgave: which stage, what has been
  // covered, and the transcript so far. The app owns this — the examiner is
  // asked for one turn at a time and told where the conversation is, rather
  // than being handed the whole history to improvise from.
  speakingStateJson String?

  responseJson String? // learner's raw answers
  // Null for writing/speaking, which have no objectively correct answer.
  score        Int?
  total        Int?
  mistakes     Int?
  wordCount    Int? // writing tasks only

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  examSession ExamSession? @relation(fields: [examSessionId], references: [id])

  @@index([userId, moduleId, category])
  @@index([examSessionId])
}

// ---------------------------------------------------------------------------
// Report card upload / OCR extraction / confirmation / reconciliation
// ---------------------------------------------------------------------------

model ReportCard {
  id         String   @id @default(cuid())
  userId     String
  filePath   String // path under access-controlled storage; never a public URL
  mimeType   String
  uploadedAt DateTime @default(now())

  status String @default("PENDING_EXTRACTION") // PENDING_EXTRACTION | PENDING_CONFIRMATION | CONFIRMED | REJECTED

  // Extracted fields (populated by the OCR/vision step, editable by the
  // learner before confirmation — see lib/ocr.ts).
  extractedSprogcenter String?
  extractedModule      Int?
  extractedDate        DateTime?
  extractedResultsJson String? // {"mundtlig": "pass", "laesning": "fail", "skrivning": "pass"}
  extractionConfidence Float?
  rawOcrText           String?

  confirmedAt        DateTime?
  reconciliationJson String? // summary of what changed vs prior in-app state

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Learner profile: the level the learner SAYS they are at.
//
// This is deliberately a separate concept from anything the app measures. A
// mock test score never writes here (see lib/unlock.ts — it only ever touches
// ModuleSkillStatus.inApp*), and nothing reads practice performance to infer
// a level. Only two things set it: onboarding, and an official test result the
// learner has told us about. See docs/product-architecture.md §7.
// ---------------------------------------------------------------------------

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique

  // "DU2" | "DU3". Null until onboarding has been completed.
  education String?
  // 1..5. The module the learner is officially at, NOT the one they are
  // studying — a learner can be working through Modul 3 material with an
  // official Modul 2 result, and both facts are true at once.
  currentModule Int?
  // "ONBOARDING" | "OFFICIAL_RESULT" — where currentModule came from, so the
  // UI can say how it knows.
  levelSource String?
  levelSetAt  DateTime?

  onboardedAt DateTime?

  // Reading interests, as a JSON array of ReadingTopic codes. On the profile
  // because it is a fact about the learner, not about any one text — and a
  // list this small does not earn a join table.
  interestsJson String?

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A real test the learner actually sat. Distinct from every in-app result:
// a PracticeResult is something this app measured, an OfficialTestResult is
// something an examiner decided.
//
// A confirmed ReportCard upload is one source of these (OCR + confirmation,
// see lib/report-cards.ts); a self-reported entry in Settings is the other.
model OfficialTestResult {
  id     String @id @default(cuid())
  userId String

  testType  String // MODULTEST | PD3
  education String? // DU2 | DU3
  module    Int? // 1..5; null for a PD3 result, which has no module
  // "PASSED" | "NOT_PASSED". Null when the learner recorded the sitting but
  // not an outcome.
  result String?
  takenAt DateTime?

  // SELF_REPORTED | REPORT_CARD. A report-card-sourced row points back at the
  // upload it came from, so the evidence is never separated from the claim.
  source       String  @default("SELF_REPORTED")
  reportCardId String?

  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Reading library
//
// Extensive reading: a learner working through Danish texts, looking things
// up, saving what is useful. Separate from LessonProgress (was I taught this?)
// and ExerciseAttempt (can I perform this?) because it answers a third
// question — how much Danish have I actually read, and what did I take from
// it. See docs/reading-module.md.
// ---------------------------------------------------------------------------

model ReadingProgress {
  id     String @id @default(cuid())
  userId String
  // ReadingText.id — a content id, not a foreign key: the library is code.
  textId String

  // OPENED the first time it is rendered, COMPLETED when the learner says so.
  // Reaching the bottom of the page is not evidence of having read anything.
  status String @default("OPENED") // OPENED | COMPLETED

  bookmarked Boolean @default(false)
  // INTERESTING | USEFUL | DIFFICULT | WANT_TO_LEARN. One mark, replaceable —
  // this feeds recommendations, and a text that is five things is no signal.
  mark String?

  // Seconds with the text open, accumulated. Rounded and coarse on purpose:
  // useful as "you have read for 20 minutes this week", not as analytics.
  readSeconds Int @default(0)

  openedAt    DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, textId])
  @@index([userId])
}

// A word or expression the learner kept.
//
// This is the learner's own vocabulary, which is a different thing from the
// seeded VocabItem bank (module-scoped content, currently empty). Where a
// saved word does correspond to a bank entry, vocabItemId links them rather
// than duplicating — one vocabulary, two sources.
model SavedWord {
  id     String @id @default(cuid())
  userId String

  // WORD or PHRASE. Danish is learned in chunks as much as in words, and a
  // learner who can only save single words ends up unable to produce the
  // sentences they can translate.
  kind String @default("WORD")

  // The form that was saved, e.g. "tager" or "tage bussen".
  danish String
  // Dictionary form, when known.
  lemma       String?
  translation String
  partOfSpeech String?
  // The sentence it was saved from — a word without its context is a flashcard.
  contextSentence String?
  // Grammar note carried over from the gloss.
  grammarNote String?

  // Where it came from, so the learner can go back and re-read it.
  sourceTextId String?

  note    String?
  learned Boolean @default(false)

  // Set when this matches an entry in the seeded bank.
  vocabItemId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The same word saved twice from two texts is one entry, not two.
  @@unique([userId, danish])
  @@index([userId])
}

// A note the learner wrote while reading, attached to whatever they had
// selected. The anchor is content-addressed (paragraph index, sentence index,
// or the word itself) rather than a character offset, so editing a text does
// not silently move every note in it.
model ReadingNote {
  id     String @id @default(cuid())
  userId String
  textId String

  anchorKind String // TEXT | PARAGRAPH | SENTENCE | WORD
  // Paragraph/sentence index as a string, or the word surface. Null for TEXT.
  anchorId String?
  // What was selected, stored so the note still reads correctly on its own.
  quote String?

  body String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, textId])
}

// A highlighted sentence. Deliberately sentence-granular for the first
// version: character ranges would need to survive content edits, and the
// learner's actual need — "mark this bit" — is met by the sentence.
model ReadingHighlight {
  id     String @id @default(cuid())
  userId String
  textId String

  sentenceIndex Int
  // YELLOW vocabulary · BLUE grammar · GREEN useful phrase · RED not understood
  color String @default("YELLOW")

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, textId, sentenceIndex])
  @@index([userId, textId])
}

// Cache for generated explanations.
//
// Not per-user: the explanation of a sentence is a fact about the sentence, so
// one learner asking pays for it and everyone benefits. Keyed by the scope
// asked about plus the level it was pitched at, since the same sentence gets a
// different answer for a beginner than for a PD3 candidate.
model ReadingExplanation {
  id     String @id @default(cuid())
  textId String

  scopeKind String // WORD | PHRASE | SENTENCE | PARAGRAPH | TEXT
  // Sentence/paragraph index, or the selected text itself.
  scopeId String
  // Reading level the explanation was written for.
  level Int
  // DEFAULT for the short answer, DEEP when the learner asked for more.
  depth String @default("DEFAULT")

  json      String
  createdAt DateTime @default(now())

  @@unique([textId, scopeKind, scopeId, level, depth])
}
