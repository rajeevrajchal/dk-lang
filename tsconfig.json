{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // prisma/ and scripts/ are command-line tooling run with tsx, not part of the
  // app: they need a generated Prisma client and a direct database connection,
  // neither of which exists on a deploy machine. `next build` type-checking
  // them made every deployment depend on `prisma generate` having run, for code
  // that never ships. They are checked on their own with tsconfig.scripts.json.
  "exclude": ["node_modules", "prisma", "scripts"]
}
